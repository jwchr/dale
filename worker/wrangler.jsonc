{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dale-live",
  "main": "index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": false,
  "vars": { "HISTORY_COLLECTION": "disabled", "ARRIVAL_CONFIDENCE": "public", "RAW_ARCHIVE": "enabled", "RAIL_GTFSRT_RAW": "enabled", "RAILDATA_RAW": "enabled", "BUSDV_RAW": "enabled", "TRAFFIC_RAW": "enabled", "WEATHER_RAW": "enabled" },
  "r2_buckets": [{ "binding": "HISTORY_ARCHIVE", "bucket_name": "dale-history" }],
  "observability": { "enabled": false },
  "durable_objects": { "bindings": [{ "name": "FEED", "class_name": "BusFeed" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BusFeed"] }]
}
